# Recommended: Groq's free tier. It runs open models on custom hardware and
# answers a play in well under a second. Get a free key (no card) at
# https://console.groq.com/keys
OPENAI_API_KEY=gsk-your-groq-key-here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# Tried once when the main model is rate limited, down or times out. The free
# tier caps each model per minute and per day, so a second, smaller model keeps
# a long game going. Leave empty to turn off.
AI_FALLBACK_MODEL=llama-3.1-8b-instant

# Other providers (any OpenAI-compatible API works):
#   OpenAI (paid):      AI_BASE_URL=https://api.openai.com/v1
#                       AI_MODEL=gpt-4o-mini
#   Google Gemini (free tier):
#                       AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                       AI_MODEL=gemini-2.5-flash-lite
#   Ollama (free, local, speed depends on your machine):
#                       OPENAI_API_KEY=not-needed
#                       AI_BASE_URL=http://localhost:11434/v1
#                       AI_MODEL=llama3.1

# Ask the provider for guaranteed JSON. Set to false only if a provider rejects
# the response_format field.
AI_JSON_MODE=true

# Only for reasoning models (gpt-5*, o-series, openai/gpt-oss-*): "minimal" or
# "low" stops them thinking for seconds about a ground out. Leave empty otherwise.
AI_REASONING_EFFORT=

# Give up on the AI after this long and show an error instead of hanging.
AI_TIMEOUT_MS=8000

# Port for the server
PORT=3001

# Worked examples in the prompt (default 4). More parse unusual plays more
# reliably but cost prompt tokens and latency. 0 disables.
FEWSHOT_EXAMPLES=4
